            <!--
                Generates claude-icon.png (16x16) and claude-icon-32.png (32x32)
                from the source SVG at generate-resources phase using Apache Batik.
                The SVG is excluded from the final JAR (see maven-resources-plugin below).
            -->
            <plugin>
                <groupId>org.codehaus.gmaven</groupId>
                <artifactId>groovy-maven-plugin</artifactId>
                <version>2.1.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.xmlgraphics</groupId>
                        <artifactId>batik-transcoder</artifactId>
                        <version>1.17</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.xmlgraphics</groupId>
                        <artifactId>batik-codec</artifactId>
                        <version>1.17</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-icons</id>
                        <phase>generate-resources</phase>
                        <goals><goal>execute</goal></goals>
                        <configuration>
                            <source>
                                import org.apache.batik.transcoder.image.PNGTranscoder
                                import org.apache.batik.transcoder.TranscoderInput
                                import org.apache.batik.transcoder.TranscoderOutput

                                def svg = new File(project.basedir,
                                    'src/main/resources/io/github/nbplugins/claudecodegui/icons/cc-gui-icon.svg')
                                def out = new File(project.build.outputDirectory,
                                    'io/github/nbplugins/claudecodegui/icons')
                                out.mkdirs()

                                [['claude-icon.png', 16f], ['claude-icon-32.png', 32f]].each { name, size ->
                                    def t = new PNGTranscoder()
                                    t.addTranscodingHint(PNGTranscoder.KEY_WIDTH, size)
                                    t.addTranscodingHint(PNGTranscoder.KEY_HEIGHT, size)
                                    def os = new FileOutputStream(new File(out, name))
                                    t.transcode(new TranscoderInput(svg.toURI().toString()),
                                                new TranscoderOutput(os))
                                    os.close()
                                    log.info("Generated ${name} (${size as int}px)")
                                }
                            </source>
                        </configuration>
                    </execution>
                    <!--
                        Some published NetBeans module jars list their module dependencies in
                        Maven-Class-Path, not just their bundled libraries. NbModuleSuite turns that
                        attribute into the module's private Class-Path, so the module gets its own copies
                        of the openide APIs (e.g. a Lookup that sees no services). The integration tests
                        (failsafe below) use copies of these jars without the module entries.
                    -->
                    <execution>
                        <id>patch-nb-test-modules</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>execute</goal></goals>
                        <configuration>
                            <source>
                                import java.util.jar.JarEntry
                                import java.util.jar.JarFile
                                import java.util.jar.JarOutputStream
                                import java.util.jar.Manifest

                                def toPatch = ['org.netbeans.modules:org-netbeans-modules-form',
                                               'org.netbeans.api:org-netbeans-modules-autoupdate-services',
                                               'org.netbeans.modules:org-netbeans-libs-freemarker']
                                def isModule = { String entry ->
                                    entry.startsWith('org.netbeans.api:') || entry.startsWith('org.netbeans.modules:')
                                }
                                def out = new File(project.build.directory, 'nb-patched-modules')
                                out.mkdirs()

                                project.artifacts.findAll { it.type == 'jar' }.each { artifact ->
                                    def jar = new JarFile(artifact.file)
                                    def manifest = jar.manifest
                                    def mavenCP = manifest?.mainAttributes?.getValue('Maven-Class-Path')
                                    if (mavenCP == null || !mavenCP.split(' ').any(isModule)) {
                                        jar.close()
                                        return
                                    }
                                    String ga = "${artifact.groupId}:${artifact.artifactId}"
                                    if (!toPatch.contains(ga)) {
                                        throw new IllegalStateException("${ga} lists modules in Maven-Class-Path: "
                                            + "add it to patch-nb-test-modules and to the failsafe classpath excludes/additions")
                                    }
                                    def patched = new Manifest(manifest)
                                    patched.mainAttributes.putValue('Maven-Class-Path',
                                        mavenCP.split(' ').findAll { !isModule(it) }.join(' '))
                                    new File(out, artifact.file.name).withOutputStream { os ->
                                        def jos = new JarOutputStream(os, patched)
                                        jar.entries().each { entry ->
                                            if (entry.name.equalsIgnoreCase('META-INF/MANIFEST.MF')) {
                                                return
                                            }
                                            jos.putNextEntry(new JarEntry(entry.name))
                                            jar.getInputStream(entry).withStream { jos &lt;&lt; it }
                                            jos.closeEntry()
                                        }
                                        jos.finish()
                                    }
                                    jar.close()
                                    log.info("Patched Maven-Class-Path of ${artifact.file.name} for the integration tests")
                                }
                            </source>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <resources>
                        <resource>
                            <directory>src/main/resources</directory>
                            <excludes>
